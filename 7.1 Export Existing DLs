#CSV File OutputFile Path
$CsvOutputFile = "C:\temp\ExportDistrolist.csv"

#Import the Exchange Online module
if (-not (Get-Module -Name ExchangeOnlineManagement -ErrorAction SilentlyContinue)) {
    Install-Module -Name ExchangeOnlineManagement -Force -AllowClobber
}
Import-Module ExchangeOnlineManagement

# Connect to Exchange Online
Connect-ExchangeOnline -Credential $YourCredentials

# Get all distribution groups
$Groups = Get-DistributionGroup -ResultSize Unlimited

# Array to store the group information
$GroupInfo = @()

# Loop through distribution groups
foreach ($GroupObj in $Groups) {
    $GroupDN = $GroupObj.DistinguishedName
    $DisplayName = $GroupObj.DisplayName
    $PrimarySmtpAddress = $GroupObj.PrimarySmtpAddress
    $SecondarySmtpAddress = $GroupObj.EmailAddresses | Where-Object { $_ -clike "smtp:*" } | ForEach-Object { $_ -replace "smtp:", "" }
    $GroupType = $GroupObj.GroupType
    $RecipientType = $GroupObj.RecipientType
    $Members = Get-DistributionGroupMember $GroupDN -ResultSize Unlimited
    $ManagedBy = $GroupObj.ManagedBy | ForEach-Object {
        $manager = $_
        if ($manager -like "*<*>") {
            $manager -replace '^.*<([^>]*)>.*$', '$1'
        } else {
            $managerEmail = (Get-Recipient -Identity $manager -ErrorAction SilentlyContinue).EmailAddresses |
                           Where-Object { $_ -clike "SMTP:*" } |
                           ForEach-Object { $_ -replace "SMTP:", "" }
            if ($managerEmail) {
                $managerEmail -join ';'
            } else {
                ''
            }
        }
    }
    $LegacyExchangeDN = $GroupObj.LegacyExchangeDN
    $Alias = $GroupObj.Alias
    $HiddenFromAddressLists = $GroupObj.HiddenFromAddressListsEnabled
    $MemberJoinRestriction = $GroupObj.MemberJoinRestriction
    $MemberDepartRestriction = $GroupObj.MemberDepartRestriction
    $RequireSenderAuthenticationEnabled = $GroupObj.RequireSenderAuthenticationEnabled
    $AcceptMessagesOnlyFrom = $GroupObj.AcceptMessagesOnlyFrom -split ';'
    $GrantSendOnBehalfTo = $GroupObj.GrantSendOnBehalfTo
    $Notes = (Get-Group $GroupDN)
    $IsDirSynced = $GroupObj.IsDirSynced
    $Owner = (Get-Group $GroupDN).ManagedBy | ForEach-Object {
        $owner = $_
        if ($owner -like "*<*>") {
            $owner -replace '^.*<([^>]*)>.*$', '$1'
        } else {
            $ownerEmail = (Get-Recipient -Identity $owner -ErrorAction SilentlyContinue).EmailAddresses |
                         Where-Object { $_ -clike "SMTP:*" } |
                         ForEach-Object { $_ -replace "SMTP:", "" }
            if ($ownerEmail) {
                $ownerEmail -join ';'
            } else {
                ''
            }
        }
    }

    # Create object and add to the array
    $GroupInfo += [PSCustomObject]@{
        DisplayName                        = $DisplayName
        PrimarySmtpAddress                 = $PrimarySmtpAddress
        SecondaryStmpAddress               = ($SecondarySmtpAddress -join ';')
        Alias                              = $Alias
        GroupType                          = $GroupType
        RecipientType                      = $RecipientType
        Members                            = ($Members.Name -join ';')
        MembersPrimarySmtpAddress          = ($Members.PrimarySmtpAddress -join ';')
        ManagedBy                          = $ManagedBy
        Owner                              = $Owner
        LegacyExchangeDN                   = $LegacyExchangeDN
        HiddenFromAddressLists             = $HiddenFromAddressLists
        MemberJoinRestriction              = $MemberJoinRestriction
        MemberDepartRestriction            = $MemberDepartRestriction
        RequireSenderAuthenticationEnabled = $RequireSenderAuthenticationEnabled
        AcceptMessagesOnlyFrom             = ($AcceptMessagesOnlyFrom -join ';')
        GrantSendOnBehalfTo                = $GrantSendOnBehalfTo
        Notes                              = $Notes.Notes
        IsDirSYnced                        = $IsDirSynced
    }
}

# Export report to CSV file
$GroupInfo | Sort-Object DisplayName | Export-Csv -Path $CsvOutputFile -NoTypeInformation
