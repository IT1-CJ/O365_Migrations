    } catch {
        Write-Host "Error setting member join restriction for distribution group '$($Group.DisplayName)': $($Error[0].Message)"
        Add-Content -Path $LogFilePath -Value "Error setting member join restriction for distribution group '$($Group.DisplayName)': $($Error[0].Message)"
    }

